<Window x:Class="MusicCatalog.Views.AnketaEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicCatalog.Views"
             mc:Ignorable="d"
        
             AllowsTransparency="True"
             Background="Transparent"
             WindowStyle="None">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    Padding="40"
                    Margin="20"
                    MaxWidth="550" Effect="{StaticResource ShadowEffect}">
                <StackPanel>

                    <TextBlock Text="{Binding Title, FallbackValue='Anketa'}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- (Opcionalno) Prikaz Id-a u režimu editovanja -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="Id:" Style="{StaticResource FormLabel}" Width="120"/>
                        <TextBlock Text="{Binding Id}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Naziv ankete" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding Naziv, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Period" Style="{StaticResource FormLabel}"/>
                    <ComboBox ItemsSource="{Binding Periods}"
                              SelectedItem="{Binding SelectedPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                              Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Datum početka" Style="{StaticResource FormLabel}"/>
                            <DatePicker SelectedDate="{Binding DatumPocetka, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Datum kraja" Style="{StaticResource FormLabel}"/>
                            <DatePicker SelectedDate="{Binding DatumKraja, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,12,0,0">
                        <Button Content="{Binding SaveButtonText, FallbackValue='Sačuvaj'}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Width="Auto"
                                Margin="0,0,12,0"/>
                        <Button Content="Otkaži"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Background="{StaticResource ErrorBrush}"
                                HorizontalAlignment="Right"/>
                    </StackPanel>


                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
