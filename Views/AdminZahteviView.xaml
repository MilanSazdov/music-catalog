<UserControl x:Class="MusicCatalog.Views.AdminZahteviView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Zahtevi za izmenu" FontSize="16" FontWeight="Bold"/>
            <Button Content="Osveži" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="Na čekanju">
            <DataGrid ItemsSource="{Binding NaCekanju}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn Header="RecenzijaId" Binding="{Binding RecenzijaId}" Width="Auto"/>
                    <DataGridTextColumn Header="Tip" Binding="{Binding TipZahteva}" Width="Auto"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                    <DataGridTextColumn Header="Nova ocena" Binding="{Binding NovaOcenaVrednost}" Width="Auto"/>
                    <DataGridTextColumn Header="Autor" Binding="{Binding AutorEmail}" Width="*"/>
                    <DataGridTemplateColumn Header="Akcije" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Prihvati" Command="{Binding DataContext.PrihvatiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Odbij" Command="{Binding DataContext.OdbijCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Obrađeni">
            <DataGrid ItemsSource="{Binding Obradjeni}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn Header="RecenzijaId" Binding="{Binding RecenzijaId}" Width="Auto"/>
                    <DataGridTextColumn Header="Tip" Binding="{Binding TipZahteva}" Width="Auto"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                    <DataGridTextColumn Header="Nova ocena" Binding="{Binding NovaOcenaVrednost}" Width="Auto"/>
                    <DataGridTextColumn Header="Autor" Binding="{Binding AutorEmail}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>