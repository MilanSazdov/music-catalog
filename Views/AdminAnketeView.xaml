<UserControl x:Class="MusicCatalog.Views.AdminAnketeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicCatalog.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="16">
        <StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="Kreiraj anketu"
                        Command="{Binding AddAnketaCommand}"
                        Width="160"
                        Margin="0,0,10,10"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}"
                        Padding="8"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Ankete}"
        SelectedItem="{Binding SelectedAnketa, Mode=TwoWay}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        CanUserAddRows="False"
        MinHeight="300"
        Background="{StaticResource SurfaceBrush}"
        RowBackground="{StaticResource SurfaceBrush}"
        AlternatingRowBackground="{StaticResource SurfaceBrush}"
        GridLinesVisibility="None"
        FocusVisualStyle="{x:Null}"
        BorderBrush="{StaticResource HintBrush}"
        HeadersVisibility="Column">

                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource HintBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="6,2" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource HintBrush}" />
                            </Trigger>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource HintBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>

                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource HintBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource HintBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="Naziv" Binding="{Binding Naziv}" Width="2*" />
                    <DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="120" />
                    <DataGridTextColumn Header="Datum početka" Binding="{Binding DatumPocetka, StringFormat={}{0:dd.MM.yyyy}}" Width="140"/>
                    <DataGridTextColumn Header="Datum kraja" Binding="{Binding DatumKraja, StringFormat={}{0:dd.MM.yyyy}}" Width="140"/>

                    <DataGridTemplateColumn Header="Akcije" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Izmeni"
                                Command="{Binding DataContext.EditAnketaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="6"
                                Margin="0,0,6,0"/>
                                    <Button Content="Obriši"
                                        Command="{Binding DataContext.DeleteAnketaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="{StaticResource ErrorBrush}"
                                        Padding="6"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>
