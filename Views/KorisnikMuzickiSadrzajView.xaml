<UserControl x:Class="MusicCatalog.Views.KorisnikMuzickiSadrzajView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Dela}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" Margin="8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding View.Naziv}" FontWeight="Bold" FontSize="14"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Text="{Binding View.Tip}" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding View.DatumIzdanja, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                            </StackPanel>

                            <DockPanel Grid.Row="2">
                                <Button Content="Prikazi ocene"
                                        DockPanel.Dock="Left"
                                        Command="{Binding DataContext.PrikaziOceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Dodaj ocenu"
                                            Visibility="{Binding HasUserRecenzija, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                                            Command="{Binding DataContext.OceniCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Izmeni ocenu"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding HasUserRecenzija, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.IzmeniOcenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>