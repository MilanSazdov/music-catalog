<Window x:Class="MusicCatalog.Views.MuzickoDeloEditView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Muzicko delo" Height="420" Width="560" WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}">
 <Grid Margin="16">
 <Grid.RowDefinitions>
 <RowDefinition Height="*"/>
 <RowDefinition Height="Auto"/>
 </Grid.RowDefinitions>

 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="160"/>
 <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>

 <TextBlock Text="Tip" Grid.Column="0" Margin="0,0,12,8" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
 <TextBlock Text="{Binding TipText}" Grid.Column="1" Margin="0,0,0,8" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>

 <TextBlock Text="Naziv" Grid.Column="0" Margin="0,32,12,8" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
 <TextBox Text="{Binding Naziv, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,32,0,8"/>

 <TextBlock Text="Trajanje (min)" Grid.Column="0" Margin="0,72,12,8" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
 <TextBox Text="{Binding TrajanjeMin, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,72,0,8"/>

 <TextBlock Text="Datum izdanja" Grid.Column="0" Margin="0,112,12,8" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
 <DatePicker SelectedDate="{Binding DatumIzdanja}" Grid.Column="1" Margin="0,112,0,8"/>

 <TextBlock Text="Zanrovi" Grid.Column="0" Margin="0,152,12,8" VerticalAlignment="Top" Foreground="{StaticResource PrimaryBrush}"/>
 <Border Grid.Column="1" Margin="0,152,0,8" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
 <ScrollViewer Height="180">
 <ItemsControl ItemsSource="{Binding Zanrovi}">
 <ItemsControl.ItemTemplate>
 <DataTemplate>
 <CheckBox Content="{Binding Naziv}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{StaticResource PrimaryBrush}"/>
 </DataTemplate>
 </ItemsControl.ItemTemplate>
 </ItemsControl>
 </ScrollViewer>
 </Border>
 </Grid>

 <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
 <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" VerticalAlignment="Center" Margin="0,0,16,0"/>
 <Button Content="Sacuvaj" Width="120" Margin="0,0,8,0" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
 <Button Content="Otkazi" Width="120" Command="{Binding CancelCommand}" Style="{StaticResource PrimaryButton}" Background="{StaticResource ErrorBrush}"/>
 </StackPanel>
 </Grid>
</Window>