<Window x:Class="MusicCatalog.Views.AlbumEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:MusicCatalog.Utils"
        Title="Novi Album" 
        Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">

    <Window.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
			    Padding="30" Margin="20"
			    Effect="{StaticResource ShadowEffect}">

            <StackPanel>

                <TextBlock Text="Dodaj / Izmeni Album" 
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Naziv" Style="{StaticResource FormLabel}"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Naziv, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <TextBlock Text="Datum izdanja" Style="{StaticResource FormLabel}" Margin="0,12,0,4"/>
                        <DatePicker SelectedDate="{Binding DatumIzdanja, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ukupno trajanje (min)" Style="{StaticResource FormLabel}"/>

                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding TrajanjeMin, StringFormat={}{0:N2}}"
                                 IsEnabled="False"
                                 Background="{StaticResource DisabledBrush}"/>
                    </StackPanel>
                </Grid>

                <GroupBox Header="Pesme u albumu" Padding="8" Margin="0,20,0,0"
                          BorderBrush="{StaticResource PrimaryBrush}" 
                          Foreground="{StaticResource PrimaryBrush}"
                          FontWeight="Bold">

                    <Border BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" MinHeight="150" MaxHeight="200" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5">
                            <ItemsControl ItemsSource="{Binding Pesme}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Naziv}"
                                                  Margin="4,2"
                                                  Foreground="{StaticResource TextBrush}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </GroupBox>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Stretch" Margin="0,20,0,0">
                    <Button Content="Sačuvaj"
                            HorizontalAlignment="Stretch"
                            Width="255"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Otkaži" 
                            HorizontalAlignment="Stretch"
                            Width="255"
                            Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource ErrorBrush}"
                            Margin="10,0,0,0"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>