<Window x:Class="MusicCatalog.Views.UmetnikInfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:MusicCatalog.Views"
        xmlns:utils="clr-namespace:MusicCatalog.Utils"
        xmlns:umetnici="clr-namespace:MusicCatalog.Models.Umetnici"
        xmlns:dela="clr-namespace:MusicCatalog.Models.MuzickiSadrzaj"
        mc:Ignorable="d"
        Title="Informacije o Umetniku"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MaxWidth="700">

	<Window.Resources>
		<utils:BooleanToVisibilityConverter x:Key="BoolToVis"/>

		<DataTemplate DataType="{x:Type dela:MuzickoDelo}">
			<TextBlock Text="{Binding Naziv}" Foreground="{StaticResource TextBrush}" Margin="2"/>
		</DataTemplate>
		<DataTemplate DataType="{x:Type umetnici:Izvodjac}">
			<TextBlock Foreground="{StaticResource TextBrush}" Margin="2">
				<Run Text="{Binding Ime}"/>
				<Run Text="{Binding Prezime}"/>
			</TextBlock>
		</DataTemplate>
	</Window.Resources>

	<Grid MouseLeftButtonDown="Window_MouseLeftButtonDown">
		<Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
			    Padding="30" Margin="20"
			    Effect="{StaticResource ShadowEffect}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
				<StackPanel MinWidth="400">
					<TextBlock Text="{Binding Title}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="150"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>


						<Image Grid.Column="0" Source="{Binding Umetnik.Slika, TargetNullValue=/Assets/placeholder.png}"
								  Stretch="UniformToFill" Height="150" Width="150"
								  Margin="0,0,20,0"/>

						<StackPanel Grid.Column="1" VerticalAlignment="Top">

							<StackPanel Visibility="{Binding IsBend, Converter={StaticResource BoolToVis}, ConverterParameter=inverse}">
								<TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10">
									<Run Text="{Binding Umetnik.Ime}"/>
									<Run Text=" "/>
									<Run Text="{Binding Umetnik.Prezime}"/>
								</TextBlock>
							</StackPanel>
							<StackPanel Visibility="{Binding IsBend, Converter={StaticResource BoolToVis}}">

								<TextBlock Text="{Binding Umetnik.Naziv}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
								<TextBlock Foreground="{StaticResource HintBrush}">
									<Run Text="Osnovan:"/>
									<Run Text="{Binding Umetnik.DatumNastanka, StringFormat='dd.MM.yyyy'}"/>
								</TextBlock>
								<TextBlock Foreground="{StaticResource HintBrush}">
									<Run Text="Status:"/>
									<Run Text="{Binding Umetnik.Aktivan, StringFormat='Aktivan: {0}'}"/>
								</TextBlock>
							</StackPanel>
						</StackPanel>
					</Grid>

					<TextBlock Text="Opis" Style="{StaticResource FormLabel}" Margin="0,20,0,4"/>
					<TextBlock Text="{Binding Umetnik.Opis}"
							  Foreground="{StaticResource TextBrush}"
							  TextWrapping="Wrap"
							  MaxHeight="120"/>

					<GroupBox Header="Članovi"
                              Foreground="{StaticResource PrimaryBrush}"
                              Margin="0,15,0,0"
                               Visibility="{Binding IsBend, Converter={StaticResource BoolToVis}}">
						<ItemsControl ItemsSource="{Binding Clanovi}" Margin="5"/>
					</GroupBox>

					<Grid Margin="0,15,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="15"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<GroupBox Grid.Column="0" Header="Albumi" Foreground="{StaticResource PrimaryBrush}">
							<ItemsControl ItemsSource="{Binding Albumi}" Margin="5"/>
						</GroupBox>

						<GroupBox Grid.Column="2" Header="Pesme" Foreground="{StaticResource PrimaryBrush}">
							<ItemsControl ItemsSource="{Binding Pesme}" Margin="5"/>
						</GroupBox>
					</Grid>

					<Button Content="Zatvori"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource PrimaryButton}"
                             Background="{StaticResource DisabledBrush}"
                            Margin="0,25,0,0"
                            HorizontalAlignment="Center"
                             Width="200"/>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>