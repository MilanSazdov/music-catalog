<UserControl x:Class="MusicCatalog.Views.RecenzijaEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding DeloNaziv}" FontWeight="Bold" FontSize="16"/>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,12,0,12">
            <TextBlock Text="Ocena (1-5) — obavezno" FontWeight="SemiBold" />
            <TextBox Width="80"
                     Text="{Binding Vrednost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Width="80"
                     Text="{Binding NovaOcenaVrednost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>

            <TextBlock Text="Opis (opciono)" Margin="0,10,0,2"/>
            <TextBox Text="{Binding Opis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="80"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Sačuvaj"
                    Command="{Binding SaveCreateCommand}"
                    Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Pošalji zahtev"
                    Command="{Binding PosaljiZahtevCommand}"
                    Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                    Margin="8,0,0,0"/>
            <Button Content="Izbriši recenziju"
                    Background="#D9534F" Foreground="White"
                    Command="{Binding IzbrisiRecenzijuCommand}"
                    Visibility="{Binding IsCreate, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                    Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>