<UserControl x:Class="MusicCatalog.Views.UrednikUmetniciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicCatalog.Views"
             xmlns:models="clr-namespace:MusicCatalog.Models.Umetnici"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type models:Bend}">
            <Border Width="220" Margin="10" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Color="Gray" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="{Binding Slika, FallbackValue='placeholder.png'}" Height="120" Stretch="UniformToFill" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="10">
                        <TextBlock Text="{Binding Naziv}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="12" Foreground="Gray" Margin="0,2,0,0">
                            <Run Text="Bend (Aktivan: "/>
                            <Run Text="{Binding Aktivan}"/>
                            <Run Text=")"/>
                        </TextBlock>
                        <TextBlock Text="{Binding DatumNastanka, StringFormat='Osnovan: {0:dd.MM.yyyy}'}" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Opis}" FontSize="12" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                        <Button Content="Izmeni" Command="{Binding DataContext.EditUmetnikCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="5,0" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Obriši" Command="{Binding DataContext.DeleteUmetnikCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="5,0" Style="{StaticResource PrimaryButton}" Background="{StaticResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:Izvodjac}">
            <Border Width="220" Margin="10" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Color="Gray" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0" Source="{Binding Slika, FallbackValue='placeholder.png'}" Height="120" Stretch="UniformToFill" HorizontalAlignment="Center"/>

                    <StackPanel Grid.Row="1" Margin="10">
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Ime}"/> <Run Text="{Binding Prezime}"/>
                        </TextBlock>
                        <TextBlock Text="Izvođač" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Opis}" FontSize="12" TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
                        <Button Content="Izmeni" Command="{Binding DataContext.EditUmetnikCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="5,0" Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Obriši" Command="{Binding DataContext.DeleteUmetnikCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="5,0" Style="{StaticResource PrimaryButton}" Background="{StaticResource ErrorBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,10,10">
            <Button Content="Dodaj Bend" Command="{Binding AddBendCommand}" Style="{StaticResource PrimaryButton}" Margin="5"/>
            <Button Content="Dodaj Izvođača" Command="{Binding AddIzvodjacCommand}" Style="{StaticResource PrimaryButton}" Margin="5"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Umetnici}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>