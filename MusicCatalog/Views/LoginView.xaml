<UserControl x:Class="MusicCatalog.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicCatalog.Views"
             xmlns:utils="clr-namespace:MusicCatalog.Utils"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource WindowBackgroundBrush}">
	<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
		<Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                Padding="40"
                Margin="20"
                MaxWidth="450" Effect="{StaticResource ShadowEffect}">
			<StackPanel>
				<TextBlock Text="Music Catalog"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

				<TextBlock Text="Prijavljivanje"
                           FontSize="20"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

				<TextBlock Text="Email adresa" Style="{StaticResource FormLabel}"/>
				<TextBox
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernTextBox}"
                    Margin="0,0,0,20"/>

				<TextBlock Text="Lozinka" Style="{StaticResource FormLabel}"/>
				<PasswordBox
                    utils:PasswordHelper.Attach="True"
                    utils:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernPasswordBox}"
                    Margin="0,0,0,20"/>

				<TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{StaticResource ErrorBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
				<Button
                    Content="PRIJAVI SE"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding LoginCommand.CanExecute, Mode=OneWay}" Style="{StaticResource PrimaryButton}"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"/>
				<Button
                    Content="Nemaš nalog? Registruj se"
                    Command="{Binding NavigateToRegisterCommand}"
                    Style="{StaticResource TextButton}"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"/>

			</StackPanel>
		</Border>
	</Grid>
</UserControl>