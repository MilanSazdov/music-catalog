<UserControl x:Class="MusicCatalog.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicCatalog.Views"
             xmlns:utils="clr-namespace:MusicCatalog.Utils"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="500" Background="{StaticResource WindowBackgroundBrush}">
	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<Grid HorizontalAlignment="Center" VerticalAlignment="Center">
			<Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
				   Padding="40"
				   Margin="20"
				   MaxWidth="450" Effect="{StaticResource ShadowEffect}">
				<StackPanel>
					<TextBlock Text="Kreiraj novi nalog"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,32"/>

					<TextBlock Text="Ime" Style="{StaticResource FormLabel}"/>
					<TextBox
                        Text="{Binding Ime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,20"/>

					<TextBlock Text="Prezime" Style="{StaticResource FormLabel}"/>
					<TextBox
                        Text="{Binding Prezime, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,20"/>

					<TextBlock Text="Email adresa" Style="{StaticResource FormLabel}"/>
					<TextBox
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        Style="{StaticResource ModernTextBox}"
                        Margin="0,0,0,20"/>

					<TextBlock Text="Lozinka" Style="{StaticResource FormLabel}"/>
					<PasswordBox
                        utils:PasswordHelper.Attach="True"
                        utils:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        Style="{StaticResource ModernPasswordBox}"
                        Margin="0,0,0,20"/>

					<TextBlock Text="Potvrdi lozinku" Style="{StaticResource FormLabel}"/>
					<PasswordBox
                        utils:PasswordHelper.Attach="True"
                        utils:PasswordHelper.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                        Style="{StaticResource ModernPasswordBox}"
                        Margin="0,0,0,20"/>

					<TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="{StaticResource ErrorBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

					<Button
                        Content="REGISTRUJ SE"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"/>

					<Button
                        Content="Već imaš nalog? Prijavi se"
                        Command="{Binding NavigateToLoginCommand}"
                        Style="{StaticResource TextButton}"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"/>

				</StackPanel>
			</Border>
		</Grid>
	</ScrollViewer>
</UserControl>