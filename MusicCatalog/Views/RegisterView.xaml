<UserControl x:Class="MusicCatalog.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MusicCatalog.Views"
             xmlns:utils="clr-namespace:MusicCatalog.Utils"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="800"
             Background="{StaticResource AppBackgroundBrush}">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto" MinWidth="350" MaxWidth="450"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

			<StackPanel VerticalAlignment="Center" Margin="32">

				<TextBlock Text="Music Catalog"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

				<TextBlock Text="Registracija"
                           FontSize="20"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,32"/>

				<TextBlock Text="Ime" Style="{StaticResource FormLabel}"/>
				<TextBox
                    Text="{Binding Ime, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernTextBox}"
                    Margin="0,0,0,16"/>

				<TextBlock Text="Prezime" Style="{StaticResource FormLabel}"/>
				<TextBox
                    Text="{Binding Prezime, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernTextBox}"
                    Margin="0,0,0,16"/>

				<TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
				<TextBox
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernTextBox}"
                    Margin="0,0,0,16"/>

				<TextBlock Text="Lozinka" Style="{StaticResource FormLabel}"/>
				<PasswordBox
                    utils:PasswordHelper.Attach="True"
                    utils:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernPasswordBox}"
                    Margin="0,0,0,16"/>

				<TextBlock Text="Potvrdi lozinku" Style="{StaticResource FormLabel}"/>
				<PasswordBox
                    utils:PasswordHelper.Attach="True"
                    utils:PasswordHelper.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ModernPasswordBox}"
                    Margin="0,0,0,16"/>

				<TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="{StaticResource ErrorBrush}"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Visibility" Value="Visible"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding ErrorMessage}" Value="">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>

				<Button
                    Content="REGISTRUJ SE"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding RegisterCommand.CanExecute, Mode=OneWay}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,16,0,0"/>

				<Button
                    Content="Već imaš nalog? Prijavi se"
                    Command="{Binding NavigateToLoginCommand}"
                    Style="{StaticResource TextButton}"
                    Margin="0,24,0,0"/>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>